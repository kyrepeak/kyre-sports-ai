# College Football market-data configuration for Kyre Sports API Step 1.
# Keep real secrets in Render Environment; never commit them.

# Persistent Kyre-owned market feed used by /api/v1/cfb/markets/*
CFB_KYRE_MARKET_FEED_PATH=/var/lib/kyre-sports-api/cfb_market_feed.json

# Required only for POST /api/v1/cfb/markets/feed.
# Set a long random value in Render Environment.
CFB_KYRE_MARKET_INGEST_TOKEN=replace-with-secret-in-render

# Invariant: market/sportsbook data is context only and stays at 0% projection weight.
