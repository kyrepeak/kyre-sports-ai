# Step 6R Supabase durable-storage template.
# Do not commit real Supabase secret keys.
# Keep filesystem selected until the schema is installed and a later activation
# step explicitly switches the backend.

WNBA_KYRE_DURABLE_STORAGE_BACKEND=filesystem

# Future Supabase activation values:
# WNBA_KYRE_DURABLE_STORAGE_BACKEND=supabase
# WNBA_KYRE_SUPABASE_URL=https://your-project-ref.supabase.co
# WNBA_KYRE_SUPABASE_SECRET_KEY=replace-with-server-side-sb_secret-key

# Optional contract overrides. Defaults match sports_api/sql/wnba_step6r_supabase.sql.
WNBA_KYRE_SUPABASE_OBJECT_TABLE=wnba_durable_objects
WNBA_KYRE_SUPABASE_LOCK_ACQUIRE_RPC=wnba_durable_lock_acquire
WNBA_KYRE_SUPABASE_LOCK_RELEASE_RPC=wnba_durable_lock_release
WNBA_KYRE_SUPABASE_TIMEOUT_SECONDS=10
WNBA_KYRE_SUPABASE_LOCK_LEASE_SECONDS=300
