# WNBA production/deployment template through Phase 6 plus MLB Step 16B packaging/lifecycle.
# Copy these values into the deployment environment. Do not commit real secrets.
# Phase 6 retires the legacy SportsGameOdds dependency in favor of the
# Kyre-owned market feed + guarded DraftKings GET/reconciliation path.

# Step 5S deployment topology. The current SQLite coordination design is
# approved for exactly ONE service replica/container. Multiple Uvicorn worker
# processes inside that single replica are protected by Step 5Q.
WNBA_DEPLOYMENT_MODE=container
WNBA_DEPLOYMENT_REPLICA_COUNT=1
WEB_CONCURRENCY=2
PORT=8000
WNBA_PERSISTENT_VOLUME_ROOT=/var/lib/kyre-sports-api

# Step 5T immutable release identity. Use the full 40-character Git SHA and an
# immutable container image reference pinned by sha256 digest.
WNBA_RELEASE_ID=wnba-api-YYYYMMDD-N
WNBA_RELEASE_CHANNEL=production
WNBA_DEPLOYMENT_REVISION=replace-with-full-40-character-git-sha
WNBA_DEPLOYMENT_IMAGE_REF=ghcr.io/kyrepeak/kyre-sports-api@sha256:replace-with-64-hex-digest
# Optional audit timestamp, timezone-aware ISO-8601.
# WNBA_RELEASE_CREATED_AT_UTC=2026-08-26T21:00:00Z

# Rollback target. For normal upgrades record the previously proven immutable
# revision and image. These MUST differ from the current release.
WNBA_RELEASE_INITIAL_DEPLOYMENT=false
WNBA_PREVIOUS_DEPLOYMENT_REVISION=replace-with-previous-full-40-character-git-sha
WNBA_PREVIOUS_DEPLOYMENT_IMAGE_REF=ghcr.io/kyrepeak/kyre-sports-api@sha256:replace-with-previous-64-hex-digest

# For the first-ever API deployment only, explicitly set:
# WNBA_RELEASE_INITIAL_DEPLOYMENT=true
# and omit the two WNBA_PREVIOUS_* values. Emergency rollback then means
# disabling production runtime while preserving the persistent volume.

# Optional external read-only Step 5S smoke target.
# WNBA_DEPLOYMENT_SMOKE_BASE_URL=https://your-api-host.example.com

# Step 5U first hosted-staging contract. The initial adapter is Render.
# Keep this staging-only and keep WNBA_PRODUCTION_RUNTIME_ENABLED=false until
# the remote hosted verification/canary chain succeeds.
WNBA_STAGING_HOST_PROVIDER=render
WNBA_HOST_ENVIRONMENT=staging
WNBA_STAGING_EXTERNAL_URL=https://your-staging-service.onrender.com
WNBA_STAGING_EXPECTED_SERVICE_NAME=kyre-sports-api-staging
WNBA_STAGING_EXPECTED_GIT_BRANCH=api-foundation-v1
# Set true only if staging uses a verified custom HTTPS domain instead of the
# service's normal onrender.com hostname.
WNBA_STAGING_ALLOW_CUSTOM_DOMAIN=false

# Render supplies these automatically at runtime and hosted checks verify them:
# RENDER=true
# RENDER_SERVICE_ID
# RENDER_SERVICE_NAME
# RENDER_SERVICE_TYPE=web
# RENDER_EXTERNAL_URL
# RENDER_EXTERNAL_HOSTNAME
# RENDER_GIT_COMMIT
# RENDER_GIT_BRANCH
# RENDER_GIT_REPO_SLUG
# RENDER_INSTANCE_ID

# Step 5V immutable registry publication + staging handoff. The published image
# MUST be the same exact name@sha256 digest recorded in WNBA_DEPLOYMENT_IMAGE_REF.
# The manual GitHub workflow .github/workflows/wnba-publish-staging-image.yml
# publishes without ever using a mutable :latest tag.
WNBA_RELEASE_REGISTRY=ghcr.io
WNBA_RELEASE_IMAGE_REPOSITORY=ghcr.io/kyrepeak/kyre-sports-api
WNBA_RELEASE_PUBLISHED_IMAGE_REF=ghcr.io/kyrepeak/kyre-sports-api@sha256:replace-with-64-hex-digest
WNBA_RELEASE_PUBLICATION_VERIFIED=true
WNBA_RELEASE_PUBLISHER=github-actions
WNBA_RELEASE_SOURCE_REPOSITORY=kyrepeak/kyre-sports-ai
WNBA_RELEASE_HANDOFF_FORMAT=render-staging-v1

# Step 5W explicit activation. During pre-activation leave the approval fields
# unset and keep the runtime switch FALSE. Only a later explicit activation
# boundary may populate approval values and flip production runtime on.
# WNBA_STAGING_ACTIVATION_APPROVED=true
# WNBA_STAGING_ACTIVATION_CHECKPOINT_SHA256=<exact pre-activation checkpoint>
# WNBA_STAGING_ACTIVATED_AT_UTC=<timezone-aware ISO-8601 deployment timestamp>
# WNBA_PRODUCTION_RUNTIME_ENABLED=true

# Fail-closed master switch. KEEP FALSE throughout Phase 6 safe-deferred mode.
WNBA_PRODUCTION_RUNTIME_ENABLED=false

# MLB Step 16B production packaging + lifecycle contract. KEEP ALL FALSE.
# A later certified Step 16C canary may explicitly enable only the lifecycle
# gate for one controlled canary; Step 16B itself never starts production.
MLB_PRODUCTION_RUNTIME_ENABLED=false
MLB_PRODUCTION_SCHEDULER_ENABLED=false
MLB_ACTIONABLE_OUTPUT_ENABLED=false
MLB_WAGERING_ENABLED=false
MLB_SUPABASE_REST_WRITE_ENABLED=false
MLB_STEP16B_DURABLE_LIFECYCLE_ENABLED=false
# Required secret-manager key: KYRE_DATABASE_URL
# Example shape only (DO NOT COMMIT A VALUE): postgresql://<user>:<password>@<host>:5432/<database>

# Phase 6 Kyre-owned market path. These are the authoritative provider defaults.
# The temporary direct/reconciled switches remain globally OFF. Step 6L may
# enable them only inside a private per-refresh environment copy after Step 6K
# authorization; the real process environment is never mutated by that path.
WNBA_MARKET_PROVIDER_MODE=kyre
WNBA_KYRE_MARKET_FEED_PATH=/var/lib/kyre-sports-api/wnba_market_feed.json
WNBA_KYRE_DIRECT_SYNC_ENABLED=false
WNBA_KYRE_DIRECT_SYNC_PROVIDER=draftkings
WNBA_KYRE_RECONCILED_SYNC_ENABLED=false
WNBA_STEP6J_CANARY_ENABLED=false
# Set only for one explicitly approved canary attempt:
# WNBA_STEP6J_ACTIVATION_ID=step6j-unique-activation-id

# Step 6L production refresh authority. KEEP FALSE until the real Step 6J
# persistent-disk canary has passed and Step 6K authorizes scheduler work.
WNBA_STEP6L_PRODUCTION_REFRESH_ENABLED=false
WNBA_STEP6L_REFRESH_LOCK_PATH=/var/lib/kyre-sports-api/.wnba-step6l-refresh.lock

# Persistent SQLite files. They must all live beneath WNBA_PERSISTENT_VOLUME_ROOT
# and be visible to every Uvicorn worker process in the single service replica.
WNBA_CURRENT_BOARD_STORE_PATH=/var/lib/kyre-sports-api/wnba_current_board.sqlite3
WNBA_PROP_FEED_STORE_PATH=/var/lib/kyre-sports-api/wnba_prop_feed.sqlite3
WNBA_BACKTEST_STORE_PATH=/var/lib/kyre-sports-api/wnba_backtest.sqlite3
WNBA_BOARD_SCHEDULER_LOCK_PATH=/var/lib/kyre-sports-api/wnba_scheduler_lock.sqlite3

# Scheduler/archive switches inherited from frozen Step 5P. These switches do
# NOT bypass WNBA_PRODUCTION_RUNTIME_ENABLED or the Step 6K/6L/6M interlocks.
WNBA_BOARD_SCHEDULER_ENABLED=true
WNBA_BOARD_AUTO_ARCHIVE_ENABLED=true
WNBA_BOARD_SCHEDULER_LOOP_SECONDS=30
WNBA_BOARD_MIN_PROVIDER_SPACING_SECONDS=60

# RETIRED LEGACY PROVIDER:
# Do not configure SPORTSGAMEODDS_API_KEY for the Phase 6 runtime. Steps 6A/6B
# are retired and Step 6C+ uses the Kyre-owned market path instead.

# HMAC secret for Step 5I/5J pregame evidence. Must be at least 32 bytes.
WNBA_BACKTEST_ARCHIVE_HMAC_SECRET=replace-with-at-least-32-random-bytes

# Optional explicit worker identity for diagnostics.
# WNBA_BOARD_SCHEDULER_INSTANCE_ID=api-worker-1
