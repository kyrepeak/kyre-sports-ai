# WNBA Step 5R + 5S production runtime/deployment template.
# Copy these values into the deployment environment. Do not commit real secrets.

# Step 5S deployment topology. The current SQLite coordination design is
# approved for exactly ONE service replica/container. Multiple Uvicorn worker
# processes inside that single replica are protected by Step 5Q.
WNBA_DEPLOYMENT_MODE=container
WNBA_DEPLOYMENT_REPLICA_COUNT=1
WEB_CONCURRENCY=2
PORT=8000
WNBA_PERSISTENT_VOLUME_ROOT=/var/lib/kyre-sports-api

# Optional deployment metadata / external smoke target.
# WNBA_DEPLOYMENT_REVISION=git-sha-or-release-id
# WNBA_DEPLOYMENT_SMOKE_BASE_URL=https://your-api-host.example.com

# Fail-closed master switch. Keep false until both endpoints are green:
# /api/v1/wnba/runtime/readiness
# /api/v1/wnba/runtime/deployment
WNBA_PRODUCTION_RUNTIME_ENABLED=false

# Persistent SQLite files. They must all live beneath WNBA_PERSISTENT_VOLUME_ROOT
# and be visible to every Uvicorn worker process in the single service replica.
WNBA_CURRENT_BOARD_STORE_PATH=/var/lib/kyre-sports-api/wnba_current_board.sqlite3
WNBA_PROP_FEED_STORE_PATH=/var/lib/kyre-sports-api/wnba_prop_feed.sqlite3
WNBA_BACKTEST_STORE_PATH=/var/lib/kyre-sports-api/wnba_backtest.sqlite3
WNBA_BOARD_SCHEDULER_LOCK_PATH=/var/lib/kyre-sports-api/wnba_scheduler_lock.sqlite3

# Scheduler/archive switches inherited from frozen Step 5P.
WNBA_BOARD_SCHEDULER_ENABLED=true
WNBA_BOARD_AUTO_ARCHIVE_ENABLED=true
WNBA_BOARD_SCHEDULER_LOOP_SECONDS=30
WNBA_BOARD_MIN_PROVIDER_SPACING_SECONDS=60

# Provider credential. Add the real value only in the deployment secret manager.
SPORTSGAMEODDS_API_KEY=replace-in-secret-manager

# HMAC secret for Step 5I/5J pregame evidence. Must be at least 32 bytes.
WNBA_BACKTEST_ARCHIVE_HMAC_SECRET=replace-with-at-least-32-random-bytes

# Optional explicit worker identity for diagnostics.
# WNBA_BOARD_SCHEDULER_INSTANCE_ID=api-worker-1
