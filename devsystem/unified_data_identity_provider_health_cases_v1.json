      "fact": "UNIT_OF_WORK is DATA_FIELD and NO_SOURCE_LOYALTY is true",
      "lesson": "route each required field independently instead of binding the page to one provider"
    },
    {
      "source": "sports_api/nfl_data_router_v1.py",
      "fact": "route_metric records provider attempts, selected provider, and fallback rank",
      "lesson": "provider fallback must retain deterministic provenance"
    },
    {
      "source": "nfl_prop_analytics_roster_truth_v1.py",
      "fact": "NFLverse maps WSH to canonical WAS while ESPN maps canonical WAS to WSH",
      "lesson": "provider-specific aliases must resolve through one canonical identity"
    },
    {
      "source": "sports_api/wnba_prop_feed_failover.py",
      "fact": "failover records provider_order, selected_provider_id, selected_failover_rank, and attempts",
      "lesson": "provider health or unusable output should move to the next source without fabricating data"
    }
