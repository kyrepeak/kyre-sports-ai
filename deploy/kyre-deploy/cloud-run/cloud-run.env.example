# KYRE DEPLOY V1 — Cloud Run activation variables
# Copy values into a temporary Cloud Shell session. Do not commit populated secrets.

KYRE_GCP_PROJECT_ID=
KYRE_CLOUD_RUN_REGION=us-west1
KYRE_CLOUD_RUN_SERVICE=kyre-sports-api
KYRE_CLOUD_RUN_IMAGE=
KYRE_CLOUD_RUN_SERVICE_ACCOUNT=

# Safety acknowledgements required by deploy-sports-api.sh.
# Set these only after the Google Cloud project, billing account, and Cloud Run spend cap exist.
KYRE_CLOUD_RUN_SPEND_CAP_CONFIRMED=false
KYRE_CLOUD_RUN_ACTIVATE=NO
